# R4 CDC contracts: flat XDC commands supported by the XDC reader.
# Primary clocks and same-domain paths are unchanged; see CDC_CONTRACTS.md.
# The shortest original period is 9.7ns. No clock groups/false paths added.
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/control_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ en0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/clear_toggle_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ cl0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/source_epoch_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ epoch0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/stat_req_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/sr0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/stat_ack_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/sa0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ fork_i/display/fault_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/ff0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/request_toggle_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/req0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/ack_toggle_reg* || NAME =~ *display_osd*/bank_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/ack0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/control_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/ctl0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ fork_i/display/fault_reg* || NAME =~ *display_guard*/fault_reg* || NAME =~ *display_identity*/write_fault_reg* || NAME =~ *display_identity*/rf1_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/fault0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_guard*/safe_video_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/safe0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/clear_toggle_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/cl0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/read_fault_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/rf0_reg*)} ] -filter {REF_PIN_NAME == D}]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/tag_toggle_reg*)} ] -to [get_pins -of_objects [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/tt0_reg*)} ] -filter {REF_PIN_NAME == D}]
# Binary-counter cells cover the Gray MSB alias after legal register merging.
# Only paths ending at the Gray first-stage receiver are affected.
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/rgray_reg* || NAME =~ *display_identity*/rd_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/rg0_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/rgray_reg* || NAME =~ *display_identity*/rd_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/rg0_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/wgray_reg* || NAME =~ *display_identity*/wr_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/wg0_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/wgray_reg* || NAME =~ *display_identity*/wr_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/wg0_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/count_gray_reg* || NAME =~ *display_identity*/shown_count_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/cg0_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/count_gray_reg* || NAME =~ *display_identity*/shown_count_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/cg0_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/stat_hold_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/stat_cache_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/stat_hold_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/stat_cache_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/request_seq_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied_seq_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/request_seq_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied_seq_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied_seq_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied0_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied_seq_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied0_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/shown_tag_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/scan_tag_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/shown_tag_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_identity*/scan_tag_reg*)} ]
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/source_epoch_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ epoch0_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/source_epoch_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ epoch0_reg*)} ]
set_property ASYNC_REG TRUE [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/applied0_reg* || NAME =~ *display_osd*/applied1_reg*)} ]

# Immutable inactive descriptor bank is captured only after synchronized commit.
set_max_delay 9.700 -datapath_only -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/desc0_reg* || NAME =~ *display_osd*/desc1_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/active_desc_reg*)} ]
set_bus_skew 9.700 -from [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/desc0_reg* || NAME =~ *display_osd*/desc1_reg*)} ] -to [get_cells -hier -filter {IS_SEQUENTIAL && (NAME =~ *display_osd*/active_desc_reg*)} ]
